{"en":[{"partOfSpeech":"Noun","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt20\" typeof=\"mw:Transclusion\"></span> <a rel=\"mw:WikiLink\" href=\"/wiki/black_bile\" title=\"black bile\">Black bile</a>, formerly thought to be one of the four \"cardinal <a rel=\"mw:WikiLink\" href=\"/wiki/humours\" title=\"humours\">humours</a>\" of animal bodies."},{"definition":"Great <a rel=\"mw:WikiLink\" href=\"/wiki/sadness\" title=\"sadness\">sadness</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/depression\" title=\"depression\">depression</a>, especially of a thoughtful or introspective nature."}]},{"partOfSpeech":"Adjective","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt123\" typeof=\"mw:Transclusion\"></span> Affected with great <a rel=\"mw:WikiLink\" href=\"/wiki/sadness\" title=\"sadness\">sadness</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/depression\" title=\"depression\">depression</a>.","parsedExamples":[{"example":"<b>Melancholy</b> people don't talk much."}],"examples":["<b>Melancholy</b> people don't talk much."]},{"definition":"Suggestive of <a rel=\"mw:WikiLink\" href=\"/wiki/wistfulness\" title=\"wistfulness\">wistfulness</a> or subdued <a rel=\"mw:WikiLink\" href=\"/wiki/emotion\" title=\"emotion\">emotion</a>."}]}]}